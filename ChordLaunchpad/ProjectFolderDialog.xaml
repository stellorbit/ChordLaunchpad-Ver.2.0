<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ChordLaunchpad.ProjectFolderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="プロジェクトの作成と保存"
    PrimaryButtonText="作成して保存"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CornerRadius="10">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">650</x:Double>
    </ContentDialog.Resources>

    <Grid Width="560" RowSpacing="14" Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <!-- 説明文 -->
            <RowDefinition Height="Auto" />
            <!-- 入力フォーム Card -->
            <RowDefinition Height="Auto" />
            <!-- 作成構成プレビュー Card -->
            <RowDefinition Height="Auto" />
            <!-- エラー/警告メッセージ -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 説明 -->
        <TextBlock x:Name="DialogDescriptionText" Grid.Row="0"
                   Text="プロジェクト専用のフォルダを作成し、プロジェクトファイルや自動バックアップ・MIDI保存先を整理して格納します。"
                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <!-- 入力フォーム Card -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12">
            <StackPanel Spacing="10">
                <!-- プロジェクト名 -->
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ProjectNameLabel" Text="プロジェクト名 (フォルダ名・ファイル名)" FontSize="12" FontWeight="SemiBold" />
                    <TextBox x:Name="ProjectNameTextBox"
                             PlaceholderText="例: MyProgression_01"
                             TextChanged="ProjectNameTextBox_TextChanged"
                             FontSize="12" Height="32" />
                </StackPanel>

                <!-- 保存先親ディレクトリ -->
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ParentDirLabel" Text="保存先ディレクトリ (親フォルダ)" FontSize="12" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ParentDirTextBox" Grid.Column="0"
                                 FontSize="11" Height="30" VerticalAlignment="Center"
                                 TextChanged="ParentDirTextBox_TextChanged" />
                        <Button x:Name="BrowseParentDirButton" Grid.Column="1" Content="参照..." Click="BrowseParentDir_Click"
                                FontSize="11" Height="30" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 作成構成プレビュー Card -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock x:Name="PreviewStructureTitleText" Text="作成されるフォルダ構成" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>

                <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,8">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED43;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock x:Name="PreviewFolderPathText" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="16,2,0,0" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7C3;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PreviewProjectFileText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED43;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="BackupFolderDescText" Text="Project Backup\ (自動一時バックアップ格納フォルダ)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xED43;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MidiFolderDescText" Text="Chord MIDI\ (MIDIエクスポート既定保存フォルダ)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- エラー/警告メッセージ -->
        <InfoBar x:Name="ValidationInfoBar" Grid.Row="3" IsOpen="False" IsClosable="False" Severity="Warning" />
    </Grid>
</ContentDialog>
