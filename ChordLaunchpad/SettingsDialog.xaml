<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ChordLaunchpad.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ChordLaunchpad.Core.Models"
    mc:Ignorable="d"
    Title="環境設定 (Settings)"
    PrimaryButtonText="保存して適用"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CornerRadius="10">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Width="620" RowSpacing="12" Margin="0,4,12,0">
        <Grid.RowDefinitions>
            <!-- Header description -->
            <RowDefinition Height="Auto" />
            <!-- Language Card -->
            <RowDefinition Height="Auto" />
            <!-- Zoom Style Card -->
            <RowDefinition Height="Auto" />
            <!-- Custom Key Card (Collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Numpad & Mouse Wheel Options Card -->
            <RowDefinition Height="Auto" />
            <!-- Project Directory & Auto-Save Card -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Description -->
        <TextBlock x:Name="SettingsDescriptionText" Grid.Row="0"
                   Text="タイムラインの横ズーム操作スタイルやプロジェクト保存先・自動バックアップ環境を設定します。"
                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <!-- Card 0: Language Selection -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock x:Name="LanguageCardTitleText" Text="表示言語 / Language" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                    <TextBlock x:Name="LanguageCardDescText" Text="ユーザーインターフェースの表示言語を選択します。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="200" SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="日本語 (Japanese)" Tag="ja-JP" />
                    <ComboBoxItem Content="English (US)" Tag="en-US" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- Card 1: Zoom Style Selection -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71E;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock x:Name="ZoomStyleTitleText" Text="タイムライン横ズーム操作スタイル" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="ZoomStyleSubText" Text="お使いのDAWや映像編集ソフトに合わせたキーバインドを選択できます。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ZoomStyleDescriptionText" Text="R: 縮小 / T: 拡大" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}" TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox x:Name="ZoomStyleComboBox" Grid.Column="1" Width="260" SelectionChanged="ZoomStyleComboBox_SelectionChanged">
                        <ComboBoxItem Content="Pro Tools スタイル (R/T)" Tag="ProTools" />
                        <ComboBoxItem Content="Cubase スタイル (G/H)" Tag="Cubase" />
                        <ComboBoxItem Content="Studio One スタイル (W/E)" Tag="StudioOne" />
                        <ComboBoxItem Content="Premiere / Resolve / FCP (Ctrl + -/=)" Tag="PremiereResolve" />
                        <ComboBoxItem Content="Avid Media Composer (Ctrl + K/L)" Tag="AvidMediaComposer" />
                        <ComboBoxItem Content="カスタム設定..." Tag="Custom" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card 2: Custom Key Assignment (Shown only when Custom is selected) -->
        <Border x:Name="CustomKeyCard" Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Visibility="Collapsed">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                    <TextBlock x:Name="CustomKeyTitleText" Text="カスタム・ズームキー割り当て" FontWeight="SemiBold" FontSize="13" />
                </StackPanel>

                <!-- Zoom In Row -->
                <Grid ColumnSpacing="8" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- In -->
                    <TextBlock x:Name="CustomInLabel" Grid.Row="0" Grid.Column="0" Text="ズーム拡大 (In):" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="CustomInKeyComboBox" Grid.Row="0" Grid.Column="1" Width="120" FontSize="12" />
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <CheckBox x:Name="CustomInCtrlCheck" Content="Ctrl" FontSize="12" />
                        <CheckBox x:Name="CustomInAltCheck" Content="Alt" FontSize="12" />
                        <CheckBox x:Name="CustomInShiftCheck" Content="Shift" FontSize="12" />
                    </StackPanel>

                    <!-- Out -->
                    <TextBlock x:Name="CustomOutLabel" Grid.Row="1" Grid.Column="0" Text="ズーム縮小 (Out):" VerticalAlignment="Center" FontSize="12" />
                    <ComboBox x:Name="CustomOutKeyComboBox" Grid.Row="1" Grid.Column="1" Width="120" FontSize="12" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <CheckBox x:Name="CustomOutCtrlCheck" Content="Ctrl" FontSize="12" />
                        <CheckBox x:Name="CustomOutAltCheck" Content="Alt" FontSize="12" />
                        <CheckBox x:Name="CustomOutShiftCheck" Content="Shift" FontSize="12" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card 3: Numpad and Wheel Zoom Options -->
        <Border Grid.Row="4" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <StackPanel Spacing="8">
                <!-- Option 1: Numpad +/- Zoom -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="NumpadZoomTitleText" Text="テンキーの [+] / [-] によるズーム操作" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="NumpadZoomDescText" Text="テンキー側のプラス・マイナスキーを単独で押してタイムラインを拡縮します。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="EnableNumpadZoomToggle" Grid.Column="1" OnContent="有効" OffContent="無効" IsOn="True" VerticalAlignment="Center" />
                </Grid>

                <MenuFlyoutSeparator Margin="0,1" />

                <!-- Option 2: Mouse Wheel Zoom (Ctrl only) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="WheelZoomTitleText" Text="マウスホイールによるズーム連携 (Ctrl + ホイール)" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="WheelZoomDescText" Text="タイムライン上で [Ctrl] キーを押しながらホイール回転でスムーズ拡縮します。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="EnableWheelZoomToggle" Grid.Column="1" OnContent="有効" OffContent="無効" IsOn="True" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card 4: Project Storage & Auto-Save -->
        <Border Grid.Row="5" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10">
            <StackPanel Spacing="10">
                <!-- Project Directory Setting -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock x:Name="ProjectDirTitleText" Text="プロジェクト保存先フォルダの扱い" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>

                    <RadioButtons x:Name="ProjectLocationRadioButtons" SelectionChanged="ProjectLocationRadioButtons_SelectionChanged">
                        <RadioButton x:Name="AskEachTimeRadio" Content="毎回保存先ディレクトリを選択する (推奨)" IsChecked="True" FontSize="11" />
                        <RadioButton x:Name="UseDefaultDirRadio" Content="指定の固定ディレクトリに自動作成・格納する" FontSize="11" />
                    </RadioButtons>

                    <!-- Fixed Directory Path Picker -->
                    <Grid x:Name="DefaultDirPanel" ColumnSpacing="8" Margin="24,0,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DefaultDirTextBox" Grid.Column="0" FontSize="11" Height="28" VerticalAlignment="Center" IsReadOnly="True" />
                        <Button x:Name="BrowseDirButton" Grid.Column="1" Content="参照..." Click="BrowseDefaultDir_Click" FontSize="11" Height="28" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <MenuFlyoutSeparator Margin="0,1" />

                <!-- Auto-Save Backup Setting -->
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74E;" FontSize="13" Foreground="{ThemeResource SystemAccentColor}" />
                                <TextBlock x:Name="AutoSaveTitleText" Text="プロジェクト一時ファイルの自動保存 (Project Backup)" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock x:Name="AutoSaveDescText" Text="プロジェクトフォルダ内の「Project Backup」に連番ファイルで自動退避します。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EnableAutoSaveToggle" Grid.Column="1" OnContent="有効" OffContent="無効" IsOn="True" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="16" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="AutoSaveIntervalLabel" Text="保存間隔 (分):" FontSize="11" VerticalAlignment="Center" />
                            <NumberBox x:Name="AutoSaveIntervalBox" Minimum="1" Maximum="120" Value="5" Width="72" Height="26" FontSize="11" SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="AutoSaveMaxBackupsLabel" Text="保持世代数 (回数):" FontSize="11" VerticalAlignment="Center" />
                            <NumberBox x:Name="AutoSaveMaxBackupsBox" Minimum="1" Maximum="99" Value="10" Width="72" Height="26" FontSize="11" SpinButtonPlacementMode="Inline" SmallChange="1" LargeChange="5" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</ContentDialog>
