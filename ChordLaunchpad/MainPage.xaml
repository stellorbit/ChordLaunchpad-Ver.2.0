<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChordLaunchpad.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:ChordLaunchpad.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="Page_KeyDown">

    <Grid Padding="12,4,12,8" RowSpacing="6">
        <Grid.RowDefinitions>
            <!-- 0: Native Menu Bar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Top Header Toolbar & Global Actions -->
            <RowDefinition Height="Auto" />
            <!-- 2: Settings & Operations Bar -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main Content (Input / Timeline / Guide) -->
            <RowDefinition Height="*" />
            <!-- 4: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Native WinUI 3 MenuBar -->
        <MenuBar Grid.Row="0" Margin="-12,-4,-12,2">
            <MenuBarItem x:Name="MenuFile" Title="ファイル">
                <MenuFlyoutItem x:Name="MenuFileNew" Text="新規作成" Click="NewProject_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuFileOpen" Text="プロジェクトを開く..." Click="OpenProjectButton_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuFileSave" Text="プロジェクトを保存..." Click="SaveProjectButton_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuFileSaveAs" Text="名前を付けて保存..." Click="SaveProjectAs_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuFileTemplates" Text="テンプレート集..." Click="OpenTemplatesButton_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="T" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuFileExportMidi" Text="MIDIファイルをエクスポート..." Click="ExportMidiButton_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="E" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuFileExit" Text="終了" Click="ExitApp_Click" />
            </MenuBarItem>

            <MenuBarItem x:Name="MenuEdit" Title="編集">
                <MenuFlyoutItem x:Name="MenuEditUndo" Text="元に戻す" Click="UndoButton_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuEditRedo" Text="やり直す" Click="RedoButton_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuEditCut" Text="切り取り" Click="Cut_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="X" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuEditCopy" Text="コピー" Click="Copy_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuEditPaste" Text="貼り付け" Click="Paste_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="MenuEditDelete" Text="削除" Click="DeleteSelected_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuEditClear" Text="全タイムラインクリア" Click="ClearTimelineButton_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuEditSettings" Text="環境設定..." Click="OpenSettings_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number0" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem x:Name="MenuView" Title="表示">
                <MenuFlyoutItem x:Name="MenuViewGuide" Text="ガイドパネル開閉" Click="ToggleRightPanelButton_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F4" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuViewZoomIn" Text="ズーム拡大" Click="ZoomIn_Click" />
                <MenuFlyoutItem x:Name="MenuViewZoomOut" Text="ズーム縮小" Click="ZoomOut_Click" />
                <MenuFlyoutItem x:Name="MenuViewZoomReset" Text="ズームリセット" Click="ZoomReset_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuViewZoomSettings" Text="ズーム操作スタイル設定..." Click="OpenSettings_Click" />
            </MenuBarItem>

            <MenuBarItem x:Name="MenuPlay" Title="再生">
                <MenuFlyoutItem x:Name="MenuPlayPlayStop" Text="再生 / 停止 (Space)" Click="PlayAllButton_Click" />
            </MenuBarItem>

            <MenuBarItem x:Name="MenuHelp" Title="ヘルプ">
                <MenuFlyoutItem x:Name="MenuHelpReference" Text="コマンド・記法リファレンス..." Click="OpenCommandReference_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F1" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MenuHelpAbout" Text="バージョン情報" Click="AboutDialog_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- 1: Top Header & Actions (Compact) -->
        <Grid Grid.Row="1" PreviewKeyDown="TopSection_PreviewKeyDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Chord Launchpad" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />

                <!-- Project Save & Open (Icon-Only Buttons) -->
                <Button x:Name="SaveProjectButton" Click="SaveProjectButton_Click" ToolTipService.ToolTip="プロジェクトを保存 (Ctrl+S)" Width="30" Height="28" Padding="0">
                    <FontIcon Glyph="&#xE74E;" FontSize="12" />
                </Button>
                <Button x:Name="OpenProjectButton" Click="OpenProjectButton_Click" ToolTipService.ToolTip="プロジェクトを開く (Ctrl+O)" Width="30" Height="28" Padding="0">
                    <FontIcon Glyph="&#xE8E5;" FontSize="12" />
                </Button>

                <!-- Template Modal Dialog Button -->
                <Button x:Name="OpenTemplatesButton" Click="OpenTemplatesButton_Click" KeyDown="OpenTemplatesButton_KeyDown" Height="28" Padding="8,1" ToolTipService.ToolTip="ジャンル別テンプレート集 (Ctrl+T)">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE8D2;" FontSize="11" />
                        <TextBlock x:Name="OpenTemplatesButtonText" Text="テンプレート集" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- Undo / Redo Buttons -->
                <Button x:Name="UndoButton" Click="UndoButton_Click" ToolTipService.ToolTip="元に戻す (Ctrl+Z)" Width="28" Height="28" Padding="0">
                    <FontIcon Glyph="&#xE7A7;" FontSize="11" />
                </Button>
                <Button x:Name="RedoButton" Click="RedoButton_Click" ToolTipService.ToolTip="やり直す (Ctrl+Y)" Width="28" Height="28" Padding="0">
                    <FontIcon Glyph="&#xE7A6;" FontSize="11" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Play / Stop -->
                <Button x:Name="PlayAllButton" Click="PlayAllButton_Click"
                        ToolTipService.ToolTip="再生 / 停止 (Space)"
                        Width="36" Height="28" Padding="0"
                        Background="#238636" Foreground="White" CornerRadius="5"
                        BorderBrush="#2EA043" BorderThickness="1">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                </Button>
                <Button x:Name="StopButton" Click="StopButton_Click"
                        ToolTipService.ToolTip="停止 (Space)"
                        Width="36" Height="28" Padding="0"
                        Background="#DA3633" Foreground="White" CornerRadius="5"
                        BorderBrush="#F85149" BorderThickness="1">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                </Button>

                <!-- MIDI Export Button -->
                <Button x:Name="ExportMidiButton" Click="ExportMidiButton_Click" ToolTipService.ToolTip="MIDIファイルを書き出し (Ctrl+E)" Height="28" Padding="7,1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE78C;" FontSize="11" />
                        <TextBlock x:Name="ExportMidiButtonText" Text="MIDI保存" FontSize="11" />
                    </StackPanel>
                </Button>

                <!-- DAW Drag Handle -->
                <Border x:Name="MidiDragHandle"
                        CanDrag="True"
                        DragStarting="MidiDragHandle_DragStarting"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="5" Height="28" Padding="9,0"
                        ToolTipService.ToolTip="このボタンをDAWのトラックへ直接ドラッグ＆ドロップしてください">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="White" />
                        <TextBlock x:Name="MidiDragHandleText" Text="DAWへMIDIドラッグ" FontWeight="SemiBold" FontSize="11" Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- Toggle Right Panel Button -->
                <Button x:Name="ToggleRightPanelButton" Click="ToggleRightPanelButton_Click" ToolTipService.ToolTip="右パネル開閉 (F4)" Width="28" Height="28" Padding="0">
                    <FontIcon Glyph="&#xE89F;" FontSize="11" />
                </Button>

                <!-- Settings Button -->
                <Button x:Name="SettingsButton" Click="OpenSettings_Click" ToolTipService.ToolTip="環境設定 (Ctrl+0)" Width="28" Height="28" Padding="0">
                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2: Settings Bar (Compact & Sleek, No "開き") -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8,4" PreviewKeyDown="TopSection_PreviewKeyDown">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Key -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="KeyLabelText" Text="キー:" VerticalAlignment="Center" FontSize="11" />
                        <ComboBox x:Name="KeyComboBox" Width="64" Height="25" FontSize="11" SelectionChanged="KeyComboBox_SelectionChanged" DropDownClosed="TopBarComboBox_DropDownClosed" />
                    </StackPanel>

                    <!-- Mode -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="ScaleLabelText" Text="スケール:" VerticalAlignment="Center" FontSize="11" />
                        <ComboBox x:Name="ModeComboBox" Width="84" Height="25" FontSize="11" SelectionChanged="ModeComboBox_SelectionChanged" DropDownClosed="TopBarComboBox_DropDownClosed">
                            <ComboBoxItem Content="メジャー" Tag="Major" IsSelected="True" />
                            <ComboBoxItem Content="マイナー" Tag="Minor" />
                        </ComboBox>
                    </StackPanel>

                    <!-- BPM & Tap Tempo (Pro Tools style) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border x:Name="BpmLabelBorder"
                                DoubleTapped="BpmLabel_DoubleTapped"
                                KeyDown="BpmLabel_KeyDown"
                                GotFocus="BpmLabel_GotFocus"
                                LostFocus="BpmLabel_LostFocus"
                                IsTabStop="True"
                                CornerRadius="4"
                                Padding="4,2"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                ToolTipService.ToolTip="ダブルクリックしてフォーカス後、[T]キーをテンポよく叩いてタップテンポ設定 (Pro Tools仕様)">
                            <TextBlock x:Name="BpmLabelText" Text="BPM:" VerticalAlignment="Center" FontSize="11" />
                        </Border>
                        <NumberBox x:Name="BpmBox" Value="120" Minimum="40" Maximum="300" SpinButtonPlacementMode="Hidden" Width="72" Height="25" FontSize="11" ValueChanged="BpmBox_ValueChanged" KeyDown="BpmBox_KeyDown" />
                    </StackPanel>

                    <!-- Tone -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="ToneLabelText" Text="音色:" VerticalAlignment="Center" FontSize="11" />
                        <ComboBox x:Name="ToneComboBox" Width="78" Height="25" FontSize="11" SelectionChanged="ToneComboBox_SelectionChanged" DropDownClosed="TopBarComboBox_DropDownClosed">
                            <ComboBoxItem Content="Piano" Tag="Piano" IsSelected="True" />
                            <ComboBoxItem Content="Pad" Tag="Pad" />
                            <ComboBoxItem Content="Organ" Tag="Organ" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Bass Addition -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="BassLabelText" Text="ベース:" VerticalAlignment="Center" FontSize="11" />
                        <ComboBox x:Name="BassComboBox" Width="88" Height="25" FontSize="11" SelectionChanged="BassComboBox_SelectionChanged" DropDownClosed="TopBarComboBox_DropDownClosed">
                            <ComboBoxItem Content="なし" Tag="None" IsSelected="True" />
                            <ComboBoxItem Content="1" Tag="One" />
                            <ComboBoxItem Content="2" Tag="Two" />
                            <ComboBoxItem Content="両方" Tag="Both" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Divider -->
                    <AppBarSeparator Height="16" />

                    <!-- Grid Snap Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE81E;" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock x:Name="GridLabelText" Text="グリッド:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="GridSnapComboBox" Width="98" Height="25" FontSize="11" SelectionChanged="GridSnapComboBox_SelectionChanged" DropDownClosed="TopBarComboBox_DropDownClosed">
                            <ComboBoxItem Content="1/16拍" Tag="0.25" />
                            <ComboBoxItem Content="1/8拍" Tag="0.5" />
                            <ComboBoxItem Content="1拍" Tag="1.0" IsSelected="True" />
                            <ComboBoxItem Content="2拍" Tag="2.0" />
                            <ComboBoxItem Content="1小節" Tag="4.0" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Divider -->
                    <AppBarSeparator Height="16" />

                    <!-- Card Operations (Duplicate, Delete, Add Marker) -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="OpsLabelText" Text="操作:" VerticalAlignment="Center" FontSize="11" Margin="0,0,2,0" />
                        <Button x:Name="DuplicateButton" Click="DuplicateSelected_Click" ToolTipService.ToolTip="選択中のコードを複製 (Ctrl+C / Ctrl+V)" Width="26" Height="25" Padding="0">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                        </Button>
                        <Button x:Name="DeleteButton" Click="DeleteSelected_Click" ToolTipService.ToolTip="選択中のコードを削除 (Backspace / Del)" Width="26" Height="25" Padding="0">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                        </Button>
                        <Button x:Name="AddMarkerButton" Click="AddMarkerButton_Click" ToolTipService.ToolTip="選択位置に転調セクションマーカーを追加" Height="25" Padding="6,0">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon Glyph="&#xE7C1;" FontSize="9" />
                                <TextBlock x:Name="AddMarkerButtonText" Text="+ マーカー" FontSize="10" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 3: Main Body: 3-Column Layout -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Compact Input (170px) -->
                <ColumnDefinition Width="170" />
                <!-- Column 1: DAW Grid Timeline & Inspector -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: Accordion Guide (Compact Height, Width 185, Collapsible) -->
                <ColumnDefinition x:Name="RightColumnDefinition" Width="185" />
            </Grid.ColumnDefinitions>

            <!-- Column 0 (Left): Compact Text Input -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="9">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="InputHeaderTitle" Text="コード / ディグリー入力" FontSize="11" FontWeight="SemiBold" />

                    <TextBox x:Name="InputTextBox" Grid.Row="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             KeyDown="InputTextBox_KeyDown"
                             FontSize="11"
                             PlaceholderText="例: 4mas 3svn 6mis 1svn&#x0a;または Fmaj7 - - - | E7 - - - | Am7 - - - | C7 - - -" />

                    <Button x:Name="ApplyInputButton" Grid.Row="2" Content="反映 (Ctrl+Enter)" HorizontalAlignment="Stretch" Click="ApplyInputButton_Click" FontSize="11" Height="26" />
                </Grid>
            </Border>

            <!-- Column 1 (Center): DAW Grid Timeline & Inspector -->
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- DAW Timeline Container -->
                <Border x:Name="TimelineOuterBorder" Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10"
                        AllowDrop="True" DragOver="Timeline_DragOver" Drop="Timeline_Drop">
                    <Grid RowSpacing="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Bar -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <TextBlock x:Name="TimelineHeaderTitle" Text="TIMELINE (進行)" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="5,1">
                                    <TextBlock x:Name="ChordCountBadge" Text="0 個" FontSize="10" />
                                </Border>
                                <Button x:Name="ClearTimelineButton" Content="全クリア" Click="ClearTimelineButton_Click" FontSize="10" Padding="5,1" Height="22" />
                                <TextBlock x:Name="TimelineHintText" Text="※ ドラッグで並び替え / ダブルクリックで試聴" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Section Markers Bar -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="MarkersItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SectionMarker">
                                        <Button Padding="6,1" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource SystemAccentColor}" Height="22">
                                            <Button.Flyout>
                                                <Flyout Opening="MarkerFlyout_Opening">
                                                    <StackPanel Spacing="6" Width="160">
                                                        <TextBlock Text="セクション設定" FontWeight="Bold" FontSize="11" />
                                                        <TextBox Header="セクション名" Text="{x:Bind Name, Mode=TwoWay}" TextChanged="MarkerName_TextChanged" Tag="{x:Bind Id}" FontSize="11" />
                                                        <ComboBox Header="キー (転調)" SelectionChanged="MarkerKey_SelectionChanged" Tag="{x:Bind Id}" Width="140" FontSize="11">
                                                            <ComboBoxItem Content="C" IsSelected="True" />
                                                            <ComboBoxItem Content="Db" />
                                                            <ComboBoxItem Content="D" />
                                                            <ComboBoxItem Content="Eb" />
                                                            <ComboBoxItem Content="E" />
                                                            <ComboBoxItem Content="F" />
                                                            <ComboBoxItem Content="F#" />
                                                            <ComboBoxItem Content="G" />
                                                            <ComboBoxItem Content="Ab" />
                                                            <ComboBoxItem Content="A" />
                                                            <ComboBoxItem Content="Bb" />
                                                            <ComboBoxItem Content="B" />
                                                        </ComboBox>
                                                        <Button Content="マーカー削除" Click="DeleteMarker_Click" Tag="{x:Bind Id}" HorizontalAlignment="Stretch" Foreground="Red" Margin="0,4,0,0" FontSize="11" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE7C1;" FontSize="9" Foreground="{ThemeResource SystemAccentColor}" />
                                                <TextBlock Text="{x:Bind Name}" FontSize="10" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Key}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- DAW Grid ScrollViewer with Cards & Background Grid -->
                        <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="2" IsTabStop="True" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                            <Grid x:Name="TimelineContentGrid" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <!-- Row 0: DAW Ruler Bar (22px) -->
                                    <RowDefinition Height="22" />
                                    <!-- Row 1: Chord Clips Track (88px) -->
                                    <RowDefinition Height="88" />
                                </Grid.RowDefinitions>

                                <!-- Background DAW Grid Canvas (Runs through Ruler & Clips) -->
                                <Canvas x:Name="TimelineGridCanvas" Grid.RowSpan="2" IsHitTestVisible="False" VerticalAlignment="Stretch" />

                                <!-- DAW Ruler Canvas (Measure Numbers & Beat Ticks) -->
                                <Canvas x:Name="TimelineRulerCanvas" Grid.Row="0" IsHitTestVisible="False" Height="22" />

                                <!-- Cards / Clips List (Spacing=0 for strict pixel alignment with grid lines) -->
                                <ItemsControl x:Name="TimelineItemsControl" Grid.Row="1">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Stretch" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChordCardItem">
                                            <!-- DAW Grid Chord Clip (CardWidth = beats * pixelsPerBeat) -->
                                            <Border Width="{x:Bind CardWidth, Mode=OneWay}"
                                                    Height="84"
                                                    Margin="0,2,0,2"
                                                    CornerRadius="4"
                                                    Padding="6,4"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    PointerPressed="ChordCard_PointerPressed"
                                                    CanDrag="True"
                                                    DragStarting="ChordCard_DragStarting"
                                                    AllowDrop="True"
                                                    DragOver="ChordCard_DragOver"
                                                    Drop="ChordCard_Drop"
                                                    VerticalAlignment="Stretch">
                                                <Grid>
                                                    <!-- Selection Highlight Overlay -->
                                                    <Border BorderBrush="{ThemeResource SystemAccentColor}"
                                                            BorderThickness="2" CornerRadius="4"
                                                            Margin="-6,-4"
                                                            Visibility="{x:Bind IsSelected, Mode=OneWay}"
                                                            IsHitTestVisible="False" />

                                                    <!-- Main Content Area -->
                                                    <Grid RowSpacing="2" Margin="6,0,6,0">
                                                        <Grid.RowDefinitions>
                                                            <!-- Header: Symbol + Close button -->
                                                            <RowDefinition Height="Auto" />
                                                            <!-- Middle: Roman Numeral -->
                                                            <RowDefinition Height="Auto" />
                                                            <!-- Footer: Duration Badge -->
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Top Row -->
                                                        <Grid Grid.Row="0">
                                                            <TextBlock Text="{x:Bind Symbol}" FontSize="13" FontWeight="Bold"
                                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Button Click="DeleteCard_Click" Tag="{x:Bind Id}" ToolTipService.ToolTip="削除 (Backspace)"
                                                                    Padding="1" MinWidth="16" Height="16" Background="Transparent" BorderThickness="0"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </Button>
                                                        </Grid>

                                                        <!-- Middle Row -->
                                                        <TextBlock Grid.Row="1" Text="{x:Bind RomanNumeral}" FontSize="10"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />

                                                        <!-- Bottom Row: Clean Duration Badge -->
                                                        <Border Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{x:Bind DurationDisplay, Mode=OneWay}" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Left Resize Handle (Drag to Trim / Syncopate Start) -->
                                                    <Border x:Name="LeftResizeGrip"
                                                            Tag="{x:Bind Id}"
                                                            Width="9"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Stretch"
                                                            Margin="-6,-4,0,-4"
                                                            CornerRadius="4,0,0,4"
                                                            Background="#100078D4"
                                                            BorderBrush="{ThemeResource SystemAccentColor}"
                                                            BorderThickness="2,0,0,0"
                                                            PointerEntered="ResizeGrip_PointerEntered"
                                                            PointerExited="ResizeGrip_PointerExited"
                                                            PointerPressed="LeftResizeGrip_PointerPressed"
                                                            PointerMoved="LeftResizeGrip_PointerMoved"
                                                            PointerReleased="LeftResizeGrip_PointerReleased"
                                                            PointerCanceled="LeftResizeGrip_PointerCanceled"
                                                            PointerCaptureLost="LeftResizeGrip_PointerCaptureLost"
                                                            ToolTipService.ToolTip="左端をドラッグして開始点・シンコペーション調整 (前倒し/後ろ倒し)" />

                                                    <!-- Right Resize Handle (Drag to Resize by Grid) -->
                                                    <Border x:Name="RightResizeGrip"
                                                            Tag="{x:Bind Id}"
                                                            Width="9"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Stretch"
                                                            Margin="0,-4,-6,-4"
                                                            CornerRadius="0,4,4,0"
                                                            Background="#100078D4"
                                                            BorderBrush="{ThemeResource SystemAccentColor}"
                                                            BorderThickness="0,0,2,0"
                                                            PointerEntered="ResizeGrip_PointerEntered"
                                                            PointerExited="ResizeGrip_PointerExited"
                                                            PointerPressed="RightResizeGrip_PointerPressed"
                                                            PointerMoved="RightResizeGrip_PointerMoved"
                                                            PointerReleased="RightResizeGrip_PointerReleased"
                                                            PointerCanceled="RightResizeGrip_PointerCanceled"
                                                            PointerCaptureLost="RightResizeGrip_PointerCaptureLost"
                                                            ToolTipService.ToolTip="右端をドラッグしてグリッド単位で長さを伸縮" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Inspector Card (Compact) with Zoom UI -->
                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="8,4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="INSPECTOR:" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="InspectorChordLabel" Text="コード:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="InspectorSymbolText" Text="-" FontWeight="SemiBold" FontSize="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="InspectorDurationLabel" Text="長さ:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="InspectorDurationText" Text="-" FontWeight="SemiBold" FontSize="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="InspectorInversionLabel" Text="転回形:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="InspectorInversionText" Text="基本" FontWeight="SemiBold" FontSize="10" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="InspectorNotesLabel" Text="構成音:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="InspectorNotesText" Text="-" FontWeight="SemiBold" FontSize="10" Foreground="{ThemeResource SystemAccentColor}" />
                        </StackPanel>

                        <!-- Right Column: Zoom Slider relocated from top bar -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <AppBarSeparator Height="14" Margin="0,0,4,0" />
                            <FontIcon Glyph="&#xE71E;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ZoomLabelText" Text="ズーム:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Slider x:Name="ZoomSlider" Minimum="24" Maximum="80" Value="40" Width="70" Height="22" ValueChanged="ZoomSlider_ValueChanged" ToolTipService.ToolTip="タイムライン表示倍率（ズーム）" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Column 2 (Right): Accordion (Expander) Guide (Compact Height, Width 185, Collapsible) -->
            <Border x:Name="RightPanelBorder" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="4">
                <Border.Resources>
                    <x:Double x:Key="ExpanderHeaderMinHeight">26</x:Double>
                    <Thickness x:Key="ExpanderHeaderPadding">8,1,6,1</Thickness>
                    <Thickness x:Key="ExpanderContentPadding">4,2,4,2</Thickness>
                </Border.Resources>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="3">
                        <!-- 1. ダイアトニックコード (GUIDE) -->
                        <Expander IsExpanded="True" HorizontalAlignment="Stretch" Padding="0" MinHeight="26">
                            <Expander.Header>
                                <TextBlock x:Name="DiatonicExpanderHeader" Text="ダイアトニック" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Expander.Header>
                            <GridView x:Name="GuideGridView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="ChordBadge_ItemClick"
                                      CanDragItems="True"
                                      DragItemsStarting="ChordBadge_DragItemsStarting"
                                      MaxHeight="120"
                                      Padding="0">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SuggestionItem">
                                        <Border Width="40" Height="36" CornerRadius="18" Margin="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1.5"
                                                ToolTipService.ToolTip="クリック: 試聴 / ドラッグ: タイムラインに追加">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="-2">
                                                <TextBlock Text="{x:Bind Symbol}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind RomanNumeral}" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Expander>

                        <!-- 2. 借用和音 (モーダルインターチェンジ) -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" Padding="0" MinHeight="26">
                            <Expander.Header>
                                <TextBlock x:Name="BorrowedExpanderHeader" Text="借用和音 (同主調)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Expander.Header>
                            <GridView x:Name="BorrowedGridView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="ChordBadge_ItemClick"
                                      CanDragItems="True"
                                      DragItemsStarting="ChordBadge_DragItemsStarting"
                                      MaxHeight="120"
                                      Padding="0">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SuggestionItem">
                                        <Border Width="40" Height="36" CornerRadius="18" Margin="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1.5"
                                                ToolTipService.ToolTip="同主調借用コード (クリック: 試聴 / ドラッグ: 追加)">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="-2">
                                                <TextBlock Text="{x:Bind Symbol}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind RomanNumeral}" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Expander>

                        <!-- 3. セカンダリードミナント -->
                        <Expander IsExpanded="False" HorizontalAlignment="Stretch" Padding="0" MinHeight="26">
                            <Expander.Header>
                                <TextBlock x:Name="SecondaryDominantsExpanderHeader" Text="セカンダリードミナント" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Expander.Header>
                            <GridView x:Name="SecondaryDominantsGridView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="ChordBadge_ItemClick"
                                      CanDragItems="True"
                                      DragItemsStarting="ChordBadge_DragItemsStarting"
                                      MaxHeight="120"
                                      Padding="0">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SuggestionItem">
                                        <Border Width="40" Height="36" CornerRadius="18" Margin="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="#F78166" BorderThickness="1.5"
                                                ToolTipService.ToolTip="セカンダリードミナント (クリック: 試聴 / ドラッグ: 追加)">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="-2">
                                                <TextBlock Text="{x:Bind Symbol}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind RomanNumeral}" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Expander>

                        <!-- 4. SUGGESTIONS (次候補) -->
                        <Expander IsExpanded="True" HorizontalAlignment="Stretch" Padding="0" MinHeight="26">
                            <Expander.Header>
                                <TextBlock x:Name="SuggestionsExpanderHeader" Text="SUGGESTIONS (次候補)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Expander.Header>
                            <GridView x:Name="SuggestionsGridView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="ChordBadge_ItemClick"
                                      CanDragItems="True"
                                      DragItemsStarting="ChordBadge_DragItemsStarting"
                                      MaxHeight="120"
                                      Padding="0">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SuggestionItem">
                                        <Border Width="40" Height="36" CornerRadius="18" Margin="1"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource SystemAccentColor}" BorderThickness="1.5"
                                                ToolTipService.ToolTip="クリック: 試聴 / ドラッグ: タイムラインに追加">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="-2">
                                                <TextBlock Text="{x:Bind Symbol}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{x:Bind RomanNumeral}" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4: Status Bar -->
        <TextBlock Grid.Row="4" x:Name="StatusTextBlock" Text="準備完了" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0" />
    </Grid>
</Page>
