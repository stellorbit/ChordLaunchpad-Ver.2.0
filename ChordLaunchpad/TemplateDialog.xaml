<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ChordLaunchpad.TemplateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ChordLaunchpad"
    mc:Ignorable="d"
    Title="定番・ジャンル別コード進行テンプレート"
    MaxWidth="920"
    MaxHeight="650"
    CloseButtonText="閉じる"
    CornerRadius="10">

    <ContentDialog.Resources>
        <!-- WinUI 3 の既定 MaxWidth (548px) を解除して広いダイアログを許可 -->
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">650</x:Double>
    </ContentDialog.Resources>

    <Grid Width="860" MinHeight="380" MaxHeight="480" RowSpacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <!-- Main Content (Left: Genre Box, Right: Templates List) -->
            <RowDefinition Height="*" />
            <!-- Auxiliary Action / Selection Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <!-- Genre Box (Left Sidebar) -->
                <ColumnDefinition Width="180" />
                <!-- Templates List (Right Pane) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Genre List Box (Left) -->
            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8,8">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="MajorCategoryLabel" Text="大分類" FontWeight="SemiBold" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0" />
                    <!-- Major Category Filter ComboBox -->
                    <ComboBox x:Name="MajorCategoryComboBox" Grid.Row="1"
                              HorizontalAlignment="Stretch" FontSize="11" Height="28"
                              SelectionChanged="MajorCategoryComboBox_SelectionChanged" />

                    <TextBlock x:Name="SubCategoryLabel" Text="サブジャンル" Grid.Row="2" FontWeight="SemiBold" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,4,0,0" />

                    <!-- Subcategory / Genre ListView -->
                    <ListView x:Name="CategoryListView" Grid.Row="3"
                              SelectionMode="Single"
                              SelectionChanged="CategoryListView_SelectionChanged"
                              Padding="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" FontSize="12" Padding="4,4" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Templates List (Right) -->
            <ListView x:Name="TemplateListView" Grid.Column="1"
                      SelectionMode="Single"
                      SelectionChanged="TemplateListView_SelectionChanged"
                      DoubleTapped="TemplateListView_DoubleTapped"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      Padding="0,0,4,0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TemplateItemViewModel">
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,2"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Template Info -->
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Progression}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Right: Action Buttons (Audition, Apply, Append) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <!-- 試聴ボタン -->
                                    <Button Click="ItemPreviewButton_Click" Tag="{x:Bind}" Padding="8,4" Height="28" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="{x:Bind PreviewIconGlyph, Mode=OneWay}" FontSize="10" />
                                            <TextBlock Text="{x:Bind PreviewButtonText, Mode=OneWay}" FontSize="11" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 適用ボタン -->
                                    <Button Click="ItemApplyButton_Click" Tag="{x:Bind}" Style="{ThemeResource AccentButtonStyle}" Padding="10,4" Height="28" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE8FB;" FontSize="10" />
                                            <TextBlock Text="{x:Bind ApplyButtonText}" FontSize="11" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 末尾に追加ボタン -->
                                    <Button Click="ItemAppendButton_Click" Tag="{x:Bind}" Padding="8,4" Height="28" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind AppendButtonText}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Selection Status & Auxiliary Actions Bar (Bottom) -->
        <Border Grid.Row="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6" Padding="12,8" Margin="0,4,0,0" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SelectedTemplateLabel" Grid.Column="0"
                           Text="選択中: なし" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Margin="4,0,16,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 削除ボタン (ユーザー定義テンプレート選択時のみ有効) -->
                    <Button x:Name="DeleteTemplateButton" Click="DeleteTemplate_Click" IsEnabled="False"
                            ToolTipService.ToolTip="選択中のユーザー定義テンプレートを削除"
                            Padding="10,4" Height="30" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="Red" />
                            <TextBlock x:Name="DeleteButtonText" Text="削除" FontSize="11" Foreground="Red" />
                        </StackPanel>
                    </Button>

                    <!-- 新規テンプレート追加ボタン (Flyout) -->
                    <Button x:Name="AddTemplateButton" Padding="10,4" Height="30" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock x:Name="AddTemplateButtonText" Text="+ 新規追加" FontSize="11" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="AddTemplateFlyout" Placement="Top">
                                <StackPanel Spacing="8" Width="300">
                                    <TextBlock x:Name="FlyoutTitleText" Text="新規テンプレートの登録" FontWeight="Bold" FontSize="12" />
                                    <TextBox x:Name="NewTemplateNameBox" Header="テンプレート名" PlaceholderText="例: マイ進行 Aメロ" FontSize="11" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewTemplateMajorBox" Header="大分類" Text="👤 ユーザー定義" FontSize="11" />
                                        <TextBox x:Name="NewTemplateCategoryBox" Grid.Column="1" Header="サブジャンル" Text="カスタム" FontSize="11" />
                                    </Grid>
                                    <TextBox x:Name="NewTemplateProgressionBox" Header="コード進行 (半角スペース区切り)" PlaceholderText="例: IVmaj7 V7 vim7 I" FontSize="11" />
                                    <Button x:Name="InsertCurrentProgressionButton" Click="InsertCurrentProgression_Click" Content="現在のタイムラインを取り込む" FontSize="10" Padding="6,2" HorizontalAlignment="Left" />
                                    <TextBox x:Name="NewTemplateDescBox" Header="説明 (任意)" PlaceholderText="進行の特徴やメモ" FontSize="11" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="AddErrorText" Text="" Foreground="Red" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button x:Name="ConfirmAddButton" Grid.Column="1" Content="登録して保存" Style="{ThemeResource AccentButtonStyle}" Click="ConfirmAddTemplate_Click" FontSize="11" Padding="12,4" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
