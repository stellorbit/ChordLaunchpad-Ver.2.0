<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ChordLaunchpad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishProfile>Properties\PublishProfiles\win-x64.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultLanguage>ja-JP</DefaultLanguage>
    <SatelliteResourceLanguages>ja;ja-JP;en;en-US</SatelliteResourceLanguages>
    <!-- バージョン・製品情報 -->
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>ChordLaunchpad Ver 2.0</Product>
    <Description>コード進行生成支援アプリケーション</Description>
    <!-- XAML コンパイルのインクリメンタルキャッシュ有効化 -->
    <XamlCompilerSaveState>true</XamlCompilerSaveState>
    <!-- NuGet Restore の静的グラフ評価で復元判定を高速化 -->
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <PackageReference Include="NAudio" Version="3.0.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- WinUI 3 (Windows App SDK) は XAML/WinRT/COM メタデータ解決のため Trimming 無効化が必須 (有効時は 0xc000027b クラッシュ) -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!-- 日本語(ja/ja-JP)と英語(en/en-US)以外の不要言語サテライトフォルダを出力から完全削除 -->
  <Target Name="RemoveUnwantedSatelliteCultures" AfterTargets="Build">
    <ItemGroup>
      <_UnwantedLanguageDirs Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)'))" />
    </ItemGroup>
    <PropertyGroup>
      <_KeepLanguages>;ja;ja-jp;en;en-us;assets;microsoft.ui.xaml;</_KeepLanguages>
    </PropertyGroup>
    <ItemGroup>
      <_DirsToRemove Include="@(_UnwantedLanguageDirs)"
                     Condition="!$(_KeepLanguages.Contains(';$([System.IO.Path]::GetFileName(&quot;%(Identity)&quot;).ToLowerInvariant());'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_DirsToRemove)" ContinueOnError="true" />
  </Target>

  <!-- パブリッシュ時に PRI ファイル (ChordLaunchpad.pri, resources.pri) および Assets フォルダを確実に出力先へコピー -->
  <Target Name="CopyPriAndAssetsToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri"
          DestinationFiles="$(PublishDir)$(TargetName).pri"
          Condition="Exists('$(TargetDir)$(TargetName).pri') and '$(PublishDir)' != ''"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri"
          DestinationFiles="$(PublishDir)resources.pri"
          Condition="Exists('$(TargetDir)$(TargetName).pri') and '$(PublishDir)' != ''"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <_AssetFiles Include="$(ProjectDir)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetFiles)"
          DestinationFolder="$(PublishDir)Assets\%(RecursiveDir)"
          Condition="'@(_AssetFiles)' != '' and '$(PublishDir)' != ''"
          SkipUnchangedFiles="true" />
  </Target>

</Project>